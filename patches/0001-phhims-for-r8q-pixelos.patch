+    // The ROM's carrier config has no VoLTE flags for this carrier and its shell override command is blocked.
+    // MODIFY_PHONE_STATE (allowlisted) lets us set them once, persistently, when they are missing.
+    private fun ensureVolteCarrierConfig(subscriptionId: Int) {
+        try {
+            if (subscriptionId < 0) return
+            val ccm = getSystemService(CarrierConfigManager::class.java) ?: return
+            val current = ccm.getConfigForSubId(subscriptionId)
+            if (current != null && current.getBoolean(CarrierConfigManager.KEY_CARRIER_VOLTE_AVAILABLE_BOOL)) return
+            val overrides = PersistableBundle()
+            overrides.putBoolean(CarrierConfigManager.KEY_CARRIER_VOLTE_AVAILABLE_BOOL, true)
+            overrides.putBoolean(CarrierConfigManager.KEY_CARRIER_VOLTE_PROVISIONING_REQUIRED_BOOL, false)
+            overrides.putBoolean(CarrierConfigManager.KEY_HIDE_ENHANCED_4G_LTE_BOOL, false)
+            overrides.putBoolean(CarrierConfigManager.KEY_EDITABLE_ENHANCED_4G_LTE_BOOL, true)
+            overrides.putBoolean(CarrierConfigManager.KEY_ENHANCED_4G_LTE_ON_BY_DEFAULT_BOOL, true)
+            overrides.putBoolean(CarrierConfigManager.KEY_CARRIER_VT_AVAILABLE_BOOL, false)
+            ccm.overrideConfig(subscriptionId, overrides, true)
+            Rlog.i(TAG, "Applied persistent VoLTE carrier config override for subId=$subscriptionId")
+        } catch (e: Exception) {
+            Rlog.w(TAG, "Could not apply VoLTE carrier config override: $e")
+        }
+    }
+
