+    // VIVACOM sends its ringback tone as early media after the 183. PhhIms plays it, and the 180
+    // also asks Telephony for its own tone, so both played at once. The first early frame with
+    // speech (AMR FT 0-7, not SID or NO_DATA) reports the call as progressing without local
+    // ringback; networks without early media (o2, ONDO) keep the local tone.
+    private fun maybeReportEarlySpeech(call: Call, ft: Int) {
+        if (!call.outgoing || callStarted.get() || ft !in 0..7) return
+        val callId = call.callHeaders["call-id"]?.getOrNull(0) ?: return
+        if (callId == earlySpeechCallId) return
+        earlySpeechCallId = callId
+        Rlog.d(TAG, "Outgoing early media carries audio; network ringback replaces the local tone callId=$callId")
+        onOutgoingCallProgressing?.invoke(Object(), noLocalRingbackExtras(callId))
+    }
