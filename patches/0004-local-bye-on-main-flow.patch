@@ -4,12 +4,20 @@ import java.io.OutputStream
 
 internal object SipRemoteDialogTermination {
 
+    /*
+     * A BYE is a request, so it goes over the main outbound flow (port_uc -> port_ps, TS 33.203),
+     * also in a dialog that the network opened. The flow an incoming INVITE arrived on ends at the
+     * P-CSCF's client port; at least one P-CSCF (VIVACOM, 284-03) drops requests there without any
+     * response, which left the other side in the call after a local hangup. The dialog writers are
+     * kept as parameters for the callers; the main flow is reopened if it went dormant.
+     */
+    @Suppress("UNUSED_PARAMETER")
     fun localDialogRequestWriter(
         incomingResponseWriter: OutputStream?,
         registeredDialogWriter: OutputStream?,
         fallbackWriter: () -> OutputStream,
     ): OutputStream =
-        incomingResponseWriter ?: registeredDialogWriter ?: fallbackWriter()
+        fallbackWriter()
 
 
 
