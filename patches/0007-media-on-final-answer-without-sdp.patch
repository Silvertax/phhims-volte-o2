+    // The answer to the INVITE's SDP offer came in a reliable 18x (with PRACK), so the 200 OK has no
+    // SDP (RFC 3262). The early dialog already holds the codec and the remote RTP address; without
+    // this, no media thread runs, no RTP flows either way, and the post-answer RTP timeout ends the
+    // call 2 s after the other side picked up. A 183 already started the threads, so this is a no-op then.
+    private fun startMediaWithoutFinalSdp() {
+        if (threadsStarted.compareAndSet(false, true)) {
+            Rlog.d(TAG, "Final answer without SDP: starting outgoing media from the early-dialog SDP answer")
+            callDecodeThread()
+            callEncodeThread()
+        }
+    }
